classDiagram
    direction TB
    GameController ..> IPlayer : manages two players
    GameController ..> IShotStrategy : asks each player for a target
    GameController ..> IBoard : reads and updates
    GameController ..> IFleet : reads and updates

    IPlayer <|.. Player
    Player <|-- HumanPlayer
    Player <|-- RandomAIPlayer
    Player <|-- HuntTargetAIPlayer
    IShotStrategy <|.. HumanPlayer
    IShotStrategy <|.. RandomAIPlayer
    IShotStrategy <|.. HuntTargetAIPlayer
    HumanPlayer ..> ICoordinateInput : reads input from

    Player *-- IBoard
    Player *-- IFleet

    IBoard <|.. Board
    Board *-- ICell
    ICell <|.. Cell
    Cell o-- IShip : occupied by
    IFleet <|.. Fleet
    Fleet *-- IShip
    IShip <|.. Ship

    %% Arrows to the value types: dashed = parameter or return value, solid = property or field.
    %% Cell, Ship, and the three players share the arrows of the interface they implement
    %% (ICell, IShip, IShotStrategy), so they have none of their own.
    %% Coordinate (struct)
    GameController ..> Coordinate
    IShotStrategy ..> Coordinate
    ICoordinateInput ..> Coordinate
    ICell --> Coordinate
    IShip --> Coordinate

    %% ShotResult (enumeration)
    GameController ..> ShotResult
    IShotStrategy ..> ShotResult

    %% GameState (enumeration)
    GameController --> GameState

    %% Orientation (enumeration)
    GameController ..> Orientation
    IShip --> Orientation

    %% ShipType (enumeration)
    IShip --> ShipType

    %% CellState (enumeration)
    ICell --> CellState

    class GameController {
        +IPlayer Player1 : readonly
        +IPlayer Player2 : readonly
        -IShotStrategy _strategy1
        -IShotStrategy _strategy2
        -IPlayer _currentPlayer
        +GameState State : readonly
        -int _turnNumber

        +event Action#60;IPlayer, Coordinate, ShotResult#62; OnShotResolved
        +event Action~IPlayer~ OnGameEnded

        +GameController(IPlayer player1, IShotStrategy strategy1, IPlayer player2, IShotStrategy strategy2)

        +GetCurrentPlayer() IPlayer
        +GetState() GameState
        +GetBoard(IPlayer player) IBoard
        +GetFleet(IPlayer player) IFleet
        +GetRemainingShips(IPlayer player) int
        +StartGame() void
        +ValidatePlaceShip(IPlayer player, IShip ship, Coordinate start, Orientation orientation) bool
        +PlaceShip(IPlayer player, IShip ship, Coordinate start, Orientation orientation) bool
        +PlaceShipsRandomly(IPlayer player, IEnumerable~IShip~ ships, Random random) void
        +TakeTurn() ShotResult
        +TakeTurn(Coordinate target) ShotResult
        +ProcessShot(IPlayer shooter, Coordinate target) ShotResult
        +SwitchTurn() void
        +CheckWinner() IPlayer?
        +EndGame(IPlayer winner) void
    }
    class IShotStrategy {
        <<interface>>
        +SelectTarget() Coordinate
        +ReceiveResult(Coordinate target, ShotResult result) void
    }
    class IPlayer {
        <<interface>>
        +int Id : readonly
        +string Name
        +IBoard Board
        +IFleet Fleet
    }
    class Player {
        <<abstract>>
        +int Id : readonly
        +string Name
        +IBoard Board
        +IFleet Fleet

        #Player(int id, string name, IBoard board, IFleet fleet)
    }
    class HumanPlayer {
        -ICoordinateInput _input

        +HumanPlayer(int id, string name, IBoard board, IFleet fleet, ICoordinateInput input)
        +SelectTarget() Coordinate
        +ReceiveResult(Coordinate target, ShotResult result) void
    }
    class RandomAIPlayer {
        -Random _random
        -HashSet~Coordinate~ _firedShots

        +RandomAIPlayer(int id, string name, IBoard board, IFleet fleet, Random random)
        +SelectTarget() Coordinate
        +ReceiveResult(Coordinate target, ShotResult result) void
    }
    class HuntTargetAIPlayer {
        -Random _random
        -HashSet~Coordinate~ _firedShots
        -Queue~Coordinate~ _targetQueue

        +HuntTargetAIPlayer(int id, string name, IBoard board, IFleet fleet, Random random)
        +SelectTarget() Coordinate
        +ReceiveResult(Coordinate target, ShotResult result) void
    }
    class ICoordinateInput {
        <<interface>>
        +ReadCoordinate() Coordinate
    }
    class IBoard {
        <<interface>>
        +int BoardSize
        +ICell[,] Cells
    }
    class Board {
        +int BoardSize : readonly
        +ICell[,] Cells

        +Board()
    }
    class ICell {
        <<interface>>
        +Coordinate Position : readonly
        +CellState State
        +IShip? OccupyingShip
        +bool IsOccupied : readonly
    }
    class Cell {
        +Coordinate Position : readonly
        +CellState State
        +IShip? OccupyingShip
        +bool IsOccupied : readonly

        +Cell(Coordinate position)
    }
    class IFleet {
        <<interface>>
        +List~IShip~ Ships
    }
    class Fleet {
        +List~IShip~ Ships

        +Fleet()
    }
    class IShip {
        <<interface>>
        +ShipType Type : readonly
        +int Length : readonly
        +Orientation Orientation
        +List~Coordinate~ Positions
        +int HitCount
        +bool IsSunk : readonly
    }
    class Ship {
        +ShipType Type : readonly
        +int Length : readonly
        +Orientation Orientation
        +List~Coordinate~ Positions
        +int HitCount
        +bool IsSunk : readonly

        +Ship(ShipType type)
    }

    namespace ValueTypes {
        class Coordinate {
            <<struct>>
            +int X : readonly
            +int Y : readonly

            +Coordinate(int x, int y)
        }
        class ShotResult {
            <<enumeration>>
            Hit,
            Miss,
            Invalid,
            Sunk,
        }
        class GameState {
            <<enumeration>>
            Setup,
            InProgress,
            Finished,
        }
        class Orientation {
            <<enumeration>>
            Vertical,
            Horizontal,
        }
        class ShipType {
            <<enumeration>>
            Carrier,
            Battleship,
            Cruiser,
            Submarine,
            Destroyer,
        }
        class CellState {
            <<enumeration>>
            Empty,
            Ship,
            Hit,
            Miss,
        }
    }
