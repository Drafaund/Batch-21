<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="Battleship.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Our code logs with Serilog.ILogger; the web SDK's implicit Microsoft.Extensions.Logging import would make the name ambiguous. -->
    <Using Remove="Microsoft.Extensions.Logging" />
    <Using Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Battleship.Core\Battleship.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>
